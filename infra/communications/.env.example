# Separate environment file per connection. Never use production tokens in tests.
COMM_DIRECTUS_URL=https://api.isvoi.ru
COMM_CONNECTION_ID=
COMM_WORKER_TOKEN=
COMM_PLATFORM=telegram
COMM_PLATFORM_TOKEN=
# Required by the MAX send worker. The certificate fingerprint is pinned in code.
COMM_MAX_TLS_CA_PATH=/opt/isvoi/infra/communications/certificates/russian_trusted_root_ca.crt
# Exact CDN hosts, verified against the connection passport (MAX/VK only).
COMM_MEDIA_HOSTS=
# Used by migration CLI only. Never give database access to delivery workers.
COMM_MIGRATION_DATABASE_URL=
