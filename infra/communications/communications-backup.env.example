# Copy to /etc/isvoi/communications-backup.env, fill only on the server, chmod 600.
COMM_BACKUP_ROOT=/opt/isvoi/backups/communications
COMM_STACK_DIR=/opt/isvoi/infra/directus-beget
COMM_PRIVATE_DIR=/opt/isvoi/infra/directus-beget/private-communications
COMM_DIRECTUS_UPLOADS_DIR=/opt/isvoi/infra/directus-beget/uploads
COMM_OFFSITE_REMOTE=isvoi-backup:BUCKET_NAME/isvoi/production
RCLONE_CONFIG=/etc/isvoi/rclone.conf
COMM_LOCAL_RETENTION_HOURS=48
COMM_BACKUP_WARN_MINUTES=45

# /etc/isvoi/rclone.conf (mode 600) has the following shape. Never commit values.
# [isvoi-backup]
# type = s3
# provider = Other
# access_key_id = ACCESS_KEY
# secret_access_key = SECRET_KEY
# endpoint = https://s3.ru1.storage.beget.cloud
# region = ru1
# force_path_style = true
# acl = private
