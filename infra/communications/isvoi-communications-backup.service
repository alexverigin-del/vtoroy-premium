[Unit]
Description=ISVOI PostgreSQL and immutable media offsite backup
After=network-online.target docker.service
Wants=network-online.target
ConditionPathExists=/etc/isvoi/communications-backup.env

[Service]
Type=oneshot
User=root
EnvironmentFile=/etc/isvoi/communications-backup.env
ExecStart=/usr/local/sbin/isvoi-communications-backup
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=25min
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/isvoi/backups/communications /opt/isvoi/infra/directus-beget/private-communications /opt/isvoi/var
