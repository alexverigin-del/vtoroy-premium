# Copy to a private file outside Git. This is a NEW file; preserve the existing bot token.
# Both this worker and the Directus endpoint must be enabled explicitly.
TELEGRAM_ENABLED=false
TELEGRAM_MODE=test
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=isvoi_help_bot
TELEGRAM_GROUP_TITLE="I СВОИ · Заявки · Белгород"
TELEGRAM_CHAT_ID=-1004317825276
# Incoming message polling is enabled only when the authenticated Directus
# session reports that stage-2 conversations are enabled.
# Subscription delivery is gated separately in Directus and starts with an allowlisted closed pilot.
TELEGRAM_DIRECTUS_URL=https://api.isvoi.ru
# Dedicated active non-admin Directus user with an empty role/policy; no collection grants.
# Its UUID must match ISVOI_TELEGRAM_WORKER_USER_ID in the Directus environment.
TELEGRAM_DIRECTUS_TOKEN=
